<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KidsTown Museum — Planetarium</title>
<style>
  body {
    font-family: 'Arial', sans-serif;
    background: #000;
    color: #fff;
    text-align: center;
    max-width: 700px;
    margin: 2rem auto;
    padding: 0 1.25rem 3rem;
  }
  h1 { font-size: 1.5rem; }
  #tourSelect button {
    font-size: 1.1rem;
    padding: 0.75rem 1.5rem;
    margin: 0.5rem;
    cursor: pointer;
    background: #222;
    color: #fff;
    border: 2px solid #fff;
    border-radius: 6px;
  }
  #tourSelect button:hover { background: #444; }
  #question {
    font-size: 1.25rem;
    margin: 1.5rem 0;
  }
  #answers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .answer-btn {
    background: #111;
    border: 2px solid #555;
    border-radius: 8px;
    padding: 0.75rem;
    cursor: pointer;
    color: #fff;
    font-size: 0.95rem;
  }
  .answer-btn img {
    max-width: 100%;
    height: 90px;
    object-fit: contain;
    display: block;
    margin: 0 auto 0.5rem;
  }
  .answer-btn:hover { border-color: #FFD700; }
  .answer-btn.correct { border-color: #4C9A6B; background: #123; }
  .answer-btn.incorrect { border-color: #C1443B; background: #300; }
  #feedback {
    margin-top: 1.25rem;
    font-size: 1.05rem;
    min-height: 3rem;
  }
  #nextBtn, #restartBtn {
    font-size: 1rem;
    padding: 0.6rem 1.25rem;
    margin-top: 1rem;
    cursor: pointer;
    display: none;
  }
  #score { margin-top: 1.5rem; color: #FFD700; }
</style>
</head>
<body>

<h1>Thank you for visiting the Planetarium</h1>

<div id="tourSelect">
  <p>Please select a tour of our Solar System:</p>
  <button data-tour="basic">Basic Tour</button>
  <button data-tour="advanced">Advanced Tour</button>
</div>

<div id="quiz" style="display:none;">
  <div id="question"></div>
  <div id="answers"></div>
  <div id="feedback"></div>
  <button id="nextBtn">Next Question →</button>
  <div id="score"></div>
</div>

<div id="done" style="display:none;">
  <h2>You've completed the tour!</h2>
  <p id="finalScore"></p>
  <button id="restartBtn" style="display:inline-block;">Choose another tour</button>
</div>

<script>
  // Converted from data/museum/ss1.dat (Basic) and ss2.dat (Advanced),
  // which originally drove scripts/museum/wizard.pl.
  const TOURS = {"basic": [{"question": "Which picture shows the only star in our Solar System?", "answers": [{"text": "Earth is one of the nine planets that orbit the Sun.", "correct": false, "image": "../../../graphics/museum/c_ear1.gif"}, {"text": "Venus is the second planet from the Sun.", "correct": false, "image": "../../../graphics/museum/c_ven1.gif"}, {"text": "The Sun is the only star in our Solar System.", "correct": true, "image": "../../../graphics/museum/c_sun1.gif"}, {"text": "Saturn is a planet that orbits the only star in our Solar System.", "correct": false, "image": "../../../graphics/museum/c_sat3.gif"}]}, {"question": "Which planet is the smallest and is furthest from the Sun?", "answers": [{"text": "Jupiter is the largest planet in our Solar System.", "correct": false, "image": "../../../graphics/museum/c_jup1.gif"}, {"text": "Venus is larger than the smallest planet.", "correct": false, "image": "../../../graphics/museum/c_ven1.gif"}, {"text": "Pluto is the smallest planet and is furthest from the Sun.", "correct": true, "image": "../../../graphics/museum/c_plu1.gif"}, {"text": "Saturn is second largest planet.", "correct": false, "image": "../../../graphics/museum/c_sat3.gif"}]}, {"question": "Which picture shows the planet that is closest to the Sun?", "answers": [{"text": "Earth is the third planet from the Sun.", "correct": false, "image": "../../../graphics/museum/c_ear1.gif"}, {"text": "Uranus is the seventh planet from the Sun.", "correct": false, "image": "../../../graphics/museum/c_ura1.gif"}, {"text": "You chose the Sun itself.", "correct": false, "image": "../../../graphics/museum/c_sun1.gif"}, {"text": "Mercury is the closest planet to the Sun.", "correct": true, "image": "../../../graphics/museum/c_mer1.gif"}]}, {"question": "Which planet is known for its \"red spot\"?", "answers": [{"text": "Jupiter is known for its red spot.", "correct": true, "image": "../../../graphics/museum/c_jup2.gif"}, {"text": "Mars is known as the \"red planet\", but not for having a \"red spot\".", "correct": false, "image": "../../../graphics/museum/c_mar1.gif"}, {"text": "A comet may travel through our solar system but a planet is what you're looking for.", "correct": false, "image": "../../../graphics/museum/c_hai1.gif"}, {"text": "Saturn is known for its rings.", "correct": false, "image": "../../../graphics/museum/c_sat3.gif"}]}, {"question": "Which planet is the largest in the Solar System?", "answers": [{"text": "The Milky Way Galaxy is larger than any planet.", "correct": false, "image": "../../../graphics/museum/c_mil1.gif"}, {"text": "Jupiter is the largest planet in the Solar System.", "correct": true, "image": "../../../graphics/museum/c_jup3.gif"}, {"text": "The Sun is larger than Jupiter but it is not considered a planet.", "correct": false, "image": "../../../graphics/museum/c_sun1.gif"}, {"text": "Saturn is not the largest planet.", "correct": false, "image": "../../../graphics/museum/c_sat3.gif"}]}, {"question": "Which planet is the seventh planet from the Sun?", "answers": [{"text": "You chose Earth, which is the third planet from the Sun.", "correct": false, "image": "../../../graphics/museum/c_ear1.gif"}, {"text": "Close but not quite.  Neptune is the eighth planet from the Sun.", "correct": false, "image": "../../../graphics/museum/c_nep2.gif"}, {"text": "Uranus is the seventh planet from the Sun.", "correct": true, "image": "../../../graphics/museum/c_ura1.gif"}, {"text": "You chose Mars, which is the fourth planet from the Sun.", "correct": false, "image": "../../../graphics/museum/c_mar1.gif"}]}, {"question": "Which planet do you live on?", "answers": [{"text": "Earth is the only planet that has life, as far as we know.", "correct": true, "image": "../../../graphics/museum/c_ear2.gif"}, {"text": "Halley's Comet does not have life upon it.", "correct": false, "image": "../../../graphics/museum/c_hai2.gif"}, {"text": "Jupiter is a gaseous planet, unable to sustain life.", "correct": false, "image": "../../../graphics/museum/c_jup1.gif"}, {"text": "Neptune is a gaseous planet, unable to sustain life.", "correct": false, "image": "../../../graphics/museum/c_nep2.gif"}]}, {"question": "Which picture shows the largest object in our Solar System?", "answers": [{"text": "Earth is not the largest object.", "correct": false, "image": "../../../graphics/museum/c_ear1.gif"}, {"text": "Venus is not the largest object.", "correct": false, "image": "../../../graphics/museum/c_ven1.gif"}, {"text": "The Sun is the largest object in our Solar System.", "correct": true, "image": "../../../graphics/museum/c_sun1.gif"}, {"text": "Saturn is large but not as large as _____", "correct": false, "image": "../../../graphics/museum/c_sat3.gif"}]}, {"question": "Which planet is the ninth planet from the Sun?", "answers": [{"text": "Jupiter is the fifth planet from the Sun.", "correct": false, "image": "../../../graphics/museum/c_jup1.gif"}, {"text": "Venus is the third planet.", "correct": false, "image": "../../../graphics/museum/c_ven1.gif"}, {"text": "Pluto is the ninth planet from the Sun.  It is also the furthest away.", "correct": true, "image": "../../../graphics/museum/c_plu1.gif"}, {"text": "Saturn is the sixth planet.", "correct": false, "image": "../../../graphics/museum/c_sat3.gif"}]}, {"question": "Pluto is the smallest planet. What is the next smallest planet?", "answers": [{"text": "Earth is not quite the second smallest.", "correct": false, "image": "../../../graphics/museum/c_ear1.gif"}, {"text": "Uranus is quite large compared to the smaller planets.", "correct": false, "image": "../../../graphics/museum/c_ura1.gif"}, {"text": "The Sun is larger than all of the planets.", "correct": false, "image": "../../../graphics/museum/c_sun1.gif"}, {"text": "Except for Pluto, Mercury is the smallest planet.", "correct": true, "image": "../../../graphics/museum/c_mer1.gif"}]}, {"question": "Which planet is known for its \"rings\"?", "answers": [{"text": "Saturn is known for its rings.  Saturn's rings are mostly ice particles.", "correct": true, "image": "../../../graphics/museum/c_sat3.gif"}, {"text": "Venus does not have any \"rings\".", "correct": false, "image": "../../../graphics/museum/c_ven1.gif"}, {"text": "A comet may travel through our solar system but a planet is what you're looking for.", "correct": false, "image": "../../../graphics/museum/c_hai1.gif"}, {"text": "Jupiter is known for its red spot, not its rings.", "correct": false, "image": "../../../graphics/museum/c_jup2.gif"}]}, {"question": "Which planet is the fourth from the Sun?", "answers": [{"text": "The Milky Way Galaxy is not a planet in our Solar System.", "correct": false, "image": "../../../graphics/museum/c_mil1.gif"}, {"text": "Mars is the fourth planet from the Sun.", "correct": true, "image": "../../../graphics/museum/c_mar1.gif"}, {"text": "Uranus is the seventh planet from the Sun.", "correct": false, "image": "../../../graphics/museum/c_ura1.gif"}, {"text": "Earth is the third planet from the Sun.", "correct": false, "image": "../../../graphics/museum/c_ear1.gif"}]}, {"question": "Which planet is the eighth planet from the Sun?", "answers": [{"text": "You chose Earth, which is the third planet from the Sun.", "correct": false, "image": "../../../graphics/museum/c_ear1.gif"}, {"text": "Close but not quite.  Jupiter is the is the fifth planet from the Sun.", "correct": false, "image": "../../../graphics/museum/c_jup2.gif"}, {"text": "Neptune is the eighth planet from the Sun.", "correct": true, "image": "../../../graphics/museum/c_nep2.gif"}, {"text": "You chose Mars, which is the fourth planet from the Sun.", "correct": false, "image": "../../../graphics/museum/c_mar1.gif"}]}, {"question": "Which planet is between Mercury and Earth?", "answers": [{"text": "Venus is the planet that resides between Mercury and Earth.", "correct": true, "image": "../../../graphics/museum/c_ven1.gif"}, {"text": "Halley's Comet is not a planet.", "correct": false, "image": "../../../graphics/museum/c_hai2.gif"}, {"text": "Jupiter is between Mars and Saturn.", "correct": false, "image": "../../../graphics/museum/c_jup1.gif"}, {"text": "Saturn is between Jupiter and Uranus.", "correct": false, "image": "../../../graphics/museum/c_sat3.gif"}]}, {"question": "Which planet is between Jupiter and Uranus?", "answers": [{"text": "Neptune resides between Uranus and Pluto.", "correct": false, "image": "../../../graphics/museum/c_nep1.gif"}, {"text": "Halley's Comet is not a planet.", "correct": false, "image": "../../../graphics/museum/c_hai2.gif"}, {"text": "Jupiter is between Mars and Saturn.", "correct": false, "image": "../../../graphics/museum/c_jup1.gif"}, {"text": "Saturn is between Jupiter and Uranus.", "correct": true, "image": "../../../graphics/museum/c_sat3.gif"}]}], "advanced": [{"question": "Which of these contains 99.85% of all the matter in the Solar System?", "answers": [{"text": "Earth accounts for a very small portion of total mass of the Solar System.", "correct": false, "image": "../../../graphics/museum/c_ear1.gif"}, {"text": "Venus accounts for a tiny portion of the total mass of the Solar System.", "correct": false, "image": "../../../graphics/museum/c_ven1.gif"}, {"text": "The Sun accounts for 99.85% of all the matter in the Solar System.  The planets only contain 0.135% of the total mass.", "correct": true, "image": "../../../graphics/museum/c_sun1.gif"}, {"text": "Although a large planet, Saturn accounts for a very small portion of the total mass of the Solar System.", "correct": false, "image": "../../../graphics/museum/c_sat3.gif"}]}, {"question": "Our Solar System resides in a spiral galaxy consisting of 200 billion stars called:", "answers": [{"text": "Jupiter is a planet in our Solar System.", "correct": false, "image": "../../../graphics/museum/c_jup1.gif"}, {"text": "Venus is a planet in our Solar System.", "correct": false, "image": "../../../graphics/museum/c_ven1.gif"}, {"text": "The Milky Way Galaxy is the home of our Solar System.", "correct": true, "image": "../../../graphics/museum/c_mil1.gif"}, {"text": "Saturn is a planet in our Solar System.", "correct": false, "image": "../../../graphics/museum/c_sat3.gif"}]}, {"question": "Because of its highly elliptical orbit, this planet is actually closer to the Sun than is Neptune during portions of its orbit.", "answers": [{"text": "You chose Earth.  Earth is the third planet from the Sun and always closer to the Sun than Neptune.", "correct": false, "image": "../../../graphics/museum/c_ear1.gif"}, {"text": "Close, but Uranus is always closer than Neptune to the Sun.", "correct": false, "image": "../../../graphics/museum/c_ura1.gif"}, {"text": "You chose the Sun itself.", "correct": false, "image": "../../../graphics/museum/c_sun1.gif"}, {"text": "Because of its irregular orbit Pluto is actually closer, at times, to the Sun than is Neptune.", "correct": true, "image": "../../../graphics/museum/c_plu1.gif"}]}, {"question": "Terrestrial Planets are the four innermost planets in the Solar System.  Which planet is a Terrestrial Planet?", "answers": [{"text": "Mercury is considered a Terrestrial Planet because it is one of the four innermost planets.  They are called Terrestrial because they are compact and rocky like the Earth's surface.", "correct": true, "image": "../../../graphics/museum/c_mer1.gif"}, {"text": "Jupiter is a Jovian Planet because of its gaseous nature.", "correct": false, "image": "../../../graphics/museum/c_jup1.gif"}, {"text": "A comet is not one of the four innermost planets.", "correct": false, "image": "../../../graphics/museum/c_hai1.gif"}, {"text": "Saturn is a Jovian Planet because of its gaseous nature.", "correct": false, "image": "../../../graphics/museum/c_sat3.gif"}]}, {"question": "The Jovian Planets are the four gaseous planets and consist of the fifth through the eighth planets.  Which planet is a Jovian Planet?", "answers": [{"text": "Venus is one of the Terrestrial Planets.", "correct": false, "image": "../../../graphics/museum/c_ven1.gif"}, {"text": "Jupiter is one of the Jovian Planets.  Saturn, Uranus and Neptune are also Jovian Planets.", "correct": true, "image": "../../../graphics/museum/c_jup3.gif"}, {"text": "Pluto is not one of the four Jovian Planets because it is not gaseous.", "correct": false, "image": "../../../graphics/museum/c_plu1.gif"}, {"text": "Earth is one of the four Terrestrial Planets.", "correct": false, "image": "../../../graphics/museum/c_ear1.gif"}]}, {"question": "Which planet is one of the four Terrestrial Planets and also has an enormous circular basin on its surface called the Caloris Basin?", "answers": [{"text": "Earth is one of the Terrestrial Planets but it does not have the Caloris Basin on its surface.", "correct": false, "image": "../../../graphics/museum/c_ear1.gif"}, {"text": "Neptune is one of the Jovian Planets.", "correct": false, "image": "../../../graphics/museum/c_nep2.gif"}, {"text": "Mercury has a large circular basin like those found on the moon called the Caloris Basin.", "correct": true, "image": "../../../graphics/museum/c_mer1.gif"}, {"text": "Mars is one of the Terrestrial Planets but it is not the one with the Caloris Basin on its surface.", "correct": false, "image": "../../../graphics/museum/c_mar1.gif"}]}, {"question": "This planet has many volcanoes and a fractured surface.  Its atmosphere is 96% carbon dioxide and its surface temperature is more than twice as hot as the Earth's.", "answers": [{"text": "Venus has an unstable surface and it is very hot.  It also has clouds made up of sulfuric acid.", "correct": true, "image": "../../../graphics/museum/c_ven1.gif"}, {"text": "Halley's Comet is not a planet.", "correct": false, "image": "../../../graphics/museum/c_hai2.gif"}, {"text": "Jupiter is a gaseous planet without volcanoes.", "correct": false, "image": "../../../graphics/museum/c_jup1.gif"}, {"text": "Neptune is a gaseous planet without volcanoes.", "correct": false, "image": "../../../graphics/museum/c_nep2.gif"}]}, {"question": "This planet has a diameter of 12756 km and the highest point on its surface is the tip of Mount Everest.  Its atmosphere is made up of 21% oxygen.", "answers": [{"text": "Saturn's atmosphere contains virtually no oxygen.  Saturn's atmosphere contains mostly hydrogen (97%).", "correct": false, "image": "../../../graphics/museum/c_sat1.gif"}, {"text": "Uranus has a diameter of 51118 km.  Almost 4 times the size of the planet with Mount Everest.", "correct": false, "image": "../../../graphics/museum/c_ura1.gif"}, {"text": "Earth's atmosphere has the oxygen that humans require to breathe.", "correct": true, "image": "../../../graphics/museum/c_ear2.gif"}, {"text": "Mars is smaller and its atmosphere is 95% carbon dioxide.", "correct": false, "image": "../../../graphics/museum/c_mar1.gif"}]}, {"question": "Which planet is larger than Mars but smaller than Earth?", "answers": [{"text": "Jupiter is many times larger than Earth.", "correct": false, "image": "../../../graphics/museum/c_jup1.gif"}, {"text": "Venus is almost twice the size of Mars but it is just barely smaller than Earth.  Venus is 12104 km in diameter.", "correct": true, "image": "../../../graphics/museum/c_ven1.gif"}, {"text": "Neptune is larger than Earth.", "correct": false, "image": "../../../graphics/museum/c_nep1.gif"}, {"text": "Saturn is a planet that is larger than Earth.", "correct": false, "image": "../../../graphics/museum/c_sat3.gif"}]}, {"question": "Which planet has one natural satellite called the \"Moon\"?", "answers": [{"text": "Earth is the third planet from the Sun and only has one natural orbiting body called the \"Moon\".", "correct": true, "image": "../../../graphics/museum/c_ear1.gif"}, {"text": "The Moon does not orbit Uranus.", "correct": false, "image": "../../../graphics/museum/c_ura1.gif"}, {"text": "Earth would be considered a natural satellite of the Sun.", "correct": false, "image": "../../../graphics/museum/c_sun1.gif"}, {"text": "Pluto does have a natural satellite called Charon.  Although this is a moon, it is not the \"Moon\".", "correct": false, "image": "../../../graphics/museum/c_plu1.gif"}]}, {"question": "This planet ranks as the third smallest planet.  It is a little hotter than Earth but not because it is closer to the Sun.", "answers": [{"text": "Mars is the third smallest planet and is hotter than Earth due to its lack of protective atmosphere.", "correct": true, "image": "../../../graphics/museum/c_mar1.gif"}, {"text": "Jupiter is the largest planet.", "correct": false, "image": "../../../graphics/museum/c_jup1.gif"}, {"text": "A comet is not one of the planets.", "correct": false, "image": "../../../graphics/museum/c_hai1.gif"}, {"text": "Saturn is a Jovian Planet that ranks second to largest.", "correct": false, "image": "../../../graphics/museum/c_sat1.gif"}]}, {"question": "This gas giant is 11 times bigger than Earth and 20% larger than Saturn.  It has a diameter of 142800km.", "answers": [{"text": "Venus is not one of the gas giants.", "correct": false, "image": "../../../graphics/museum/c_ven1.gif"}, {"text": "Jupiter is a gas giant and the largest planet in the Solar System.  Two of Jupiter's moons, Io and Europa can be seen in the picture.", "correct": true, "image": "../../../graphics/museum/c_jup1.gif"}, {"text": "Pluto is the smallest planet.", "correct": false, "image": "../../../graphics/museum/c_plu1.gif"}, {"text": "The Earth is not a gas giant.", "correct": false, "image": "../../../graphics/museum/c_ear1.gif"}]}, {"question": "This planet is the fourth largest planet and has a larger mass than Uranus.  It is nicknamed \"The Mystic\".", "answers": [{"text": "Neptune is smaller than Uranus but it is larger in mass.  It will actually be the furthest planet from the Sun until 1999 when Pluto again becomes furthest.", "correct": true, "image": "../../../graphics/museum/c_nep1.gif"}, {"text": "Halley's Comet is not a planet.", "correct": false, "image": "../../../graphics/museum/c_hai2.gif"}, {"text": "Jupiter is the largest planet.", "correct": false, "image": "../../../graphics/museum/c_jup1.gif"}, {"text": "Pluto is the smallest planet.", "correct": false, "image": "../../../graphics/museum/c_plu1.gif"}]}]};

  let currentTour = [];
  let index = 0;
  let score = 0;
  let answered = false;

  const tourSelect = document.getElementById("tourSelect");
  const quiz = document.getElementById("quiz");
  const doneScreen = document.getElementById("done");
  const questionEl = document.getElementById("question");
  const answersEl = document.getElementById("answers");
  const feedbackEl = document.getElementById("feedback");
  const nextBtn = document.getElementById("nextBtn");
  const scoreEl = document.getElementById("score");

  document.querySelectorAll("#tourSelect button").forEach(btn => {
    btn.addEventListener("click", () => startTour(btn.dataset.tour));
  });

  function startTour(name) {
    currentTour = TOURS[name];
    index = 0;
    score = 0;
    tourSelect.style.display = "none";
    doneScreen.style.display = "none";
    quiz.style.display = "block";
    showQuestion();
  }

  function showQuestion() {
    answered = false;
    feedbackEl.textContent = "";
    nextBtn.style.display = "none";
    const q = currentTour[index];
    questionEl.textContent = `Question ${index + 1} of ${currentTour.length}: ${q.question}`;

    answersEl.innerHTML = "";
    q.answers.forEach(ans => {
      const btn = document.createElement("button");
      btn.className = "answer-btn";
      btn.innerHTML = `<img src="${ans.image}" alt=""><span>${ans.text.split(".")[0]}.</span>`;
      btn.addEventListener("click", () => handleAnswer(ans, btn));
      answersEl.appendChild(btn);
    });

    scoreEl.textContent = `Score: ${score} / ${index}`;
  }

  function handleAnswer(ans, btn) {
    if (answered) return;
    answered = true;

    if (ans.correct) {
      btn.classList.add("correct");
      feedbackEl.textContent = "Correct! " + ans.text;
      score++;
    } else {
      btn.classList.add("incorrect");
      feedbackEl.textContent = "Try again — " + ans.text;
    }

    nextBtn.style.display = "inline-block";
    nextBtn.textContent = index + 1 < currentTour.length ? "Next Question →" : "See Results";
  }

  nextBtn.addEventListener("click", () => {
    index++;
    if (index < currentTour.length) {
      showQuestion();
    } else {
      quiz.style.display = "none";
      doneScreen.style.display = "block";
      document.getElementById("finalScore").textContent =
        `You got ${score} out of ${currentTour.length} correct.`;
    }
  });

  document.getElementById("restartBtn").addEventListener("click", () => {
    doneScreen.style.display = "none";
    tourSelect.style.display = "block";
  });
</script>

</body>
</html>